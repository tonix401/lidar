    "@mrs6000/web": "workspace:*",
    "@mrs6000/wire": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
